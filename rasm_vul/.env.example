# Copy to .env for local use, or enter these in Render -> Environment
EMBEDDER=hash                 # must match how data/kb was built (hash = demo, unixcoder = real)
ADMIN_TOKEN=change-me-to-a-long-random-string   # REQUIRED for the Review tab
# LLM (optional, paper used DeepSeek-V3)
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_API_KEY=
# LLM_MODEL=deepseek-chat
# Evaluation on a real test split:
# EVAL_DATASET=data/primevul_test_paired.jsonl
# RUN_EVAL_ON_STARTUP=true
# FEEDBACK_DIR=data/feedback  # point at a persistent disk
